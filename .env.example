# Copy to .env, then generate a NEW secret with: python -c "import secrets; print(secrets.token_hex(32))"
APP_ENV=development
FLASK_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
# Leave DATABASE_URL unset for instance/workforce.db.
# Existing installations: sqlite:///C:/absolute/path/employee_mgmt.db (backup first).
WORKFORCE_TIMEZONE=UTC
RATELIMIT_STORAGE_URI=memory://
# Store databases default to instance/stores; production must use durable, private storage.
# STORE_DATABASE_ROOT=C:/absolute/private/store-databases
# Owner signup is enabled in development, disabled in production unless explicitly enabled.
# PUBLIC_STORE_OWNER_REGISTRATION=false
